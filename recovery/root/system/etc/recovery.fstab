# mount point       fstype    device                                                                flags
/sdcard1            vfat      /dev/block/mmcblk1p1                                                  flags=display="Sdcard1";
/storage            ramdisk   defaults                                                              flags=display="Storage";logical;
/dload              ramdisk   defaults                                                              flags=display="Dload";logical;

# 动态分区 (super 内, 用 mapper)
/system             ext4      /dev/block/mapper/system                                              flags=display="System";backup=1;
/system_image       emmc      /dev/block/mapper/system                                              flags=display="System image";backup=1;flashimg=1;logical
/vendor             ext4      /dev/block/mapper/vendor                                              flags=display="Vendor";backup=1;
/vendor_image       emmc      /dev/block/mapper/vendor                                              flags=display="Vendor image";backup=1;flashimg=1;logical
/product            ext4      /dev/block/mapper/product                                             flags=display="Product";backup=1;
/product_image      emmc      /dev/block/mapper/product                                             flags=display="Product image";backup=1;flashimg=1;logical

# 物理分区
/cache              ext4      /dev/block/bootdevice/by-name/cache                                   flags=display="Cache";
/data               f2fs      /dev/block/bootdevice/by-name/userdata                                flags=display="Data";
/misc               emmc      /dev/block/bootdevice/by-name/misc                                    flags=display="Misc";backup=1;flashimg=1;
/boot               emmc      /dev/block/bootdevice/by-name/boot                                    flags=display="Boot";backup=1;flashimg=1;
/uboot              emmc      /dev/block/bootdevice/by-name/uboot                                   flags=display="Uboot";backup=1;
/recovery           emmc      /dev/block/bootdevice/by-name/recovery                                flags=display="Recovery";backup=1;flashimg=1;
/recovery_ramdisk   emmc      /dev/block/bootdevice/by-name/recovery_ramdisk                        flags=display="Recovery_Ramdisk";backup=1;flashimg=1;
/recovery_vendor    emmc      /dev/block/bootdevice/by-name/recovery_vendor                         flags=display="Recovery_Vendor";backup=1;flashimg=1;
/dtbo               emmc      /dev/block/bootdevice/by-name/dtbo                                    flags=display="Dtbo";backup=1;flashimg=1;
/vbmeta             emmc      /dev/block/bootdevice/by-name/vbmeta                                  flags=display="VBMeta";backup=0;flashimg=1;
/hw_product         ext4      /dev/block/bootdevice/by-name/hw_product                              flags=display="Hw_product";
/version            ext4      /dev/block/bootdevice/by-name/version                                 flags=display="Version";
/cust               ext4      /dev/block/bootdevice/by-name/cust                                    flags=display="Cust";
/log                ext4      /dev/block/bootdevice/by-name/log                                     flags=display="Log";
/metadata           ext4      /dev/block/bootdevice/by-name/metadata                                flags=display="Metadata";
/nvdata             ext4      /dev/block/bootdevice/by-name/nvdata                                  flags=display="Nvdata";

# 外置存储
/usb                vfat      /dev/block/sdd1                                                       flags=display="Usb";
/usb_ufs            vfat      /dev/block/sdd1                                                       flags=display="Usb_ufs";
/usb_emmc           vfat      /dev/block/sda1                                                       flags=display="Usb_emmc";
